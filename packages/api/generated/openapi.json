  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Authenticated": {
        "type": "object",
        "required": [
          "authenticated"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "Availability": {
        "type": "object",
        "required": [
          "meetingType",
          "timeZone",
          "windowStart",
          "windowEnd",
          "days"
        ],
        "properties": {
          "meetingType": {
            "$ref": "#/components/schemas/PublicMeetingType"
          },
          "timeZone": {
            "type": "string",
            "enum": [
              "Europe/Moscow"
            ]
          },
          "windowStart": {
            "type": "string"
          },
          "windowEnd": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityDay"
            }
          }
        }
      },
      "AvailabilityDay": {
        "type": "object",
        "required": [
          "date",
          "slots"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          }
        }
      },
      "BookingResult": {
        "type": "object",
        "required": [
          "booking",
          "confirmationUrl"
        ],
        "properties": {
          "booking": {
            "$ref": "#/components/schemas/GuestBooking"
          },
          "confirmationUrl": {
            "type": "string"
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItem"
            }
          }
        }
      },
      "CatalogItem": {
        "type": "object",
        "required": [
          "nearestStartsAt"
        ],
        "properties": {
          "nearestStartsAt": {
            "type": "string",
            "nullable": true
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/PublicMeetingType"
          }
        ]
      },
      "CreateBookingRequest": {
        "type": "object",
        "required": [
          "attemptId",
          "meetingTypeId",
          "startsAt",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "attemptId": {
            "type": "string"
          },
          "meetingTypeId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string"
          },
          "guestName": {
            "type": "string"
          },
          "guestEmail": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          }
        }
      },
      "CreateMeetingTypeRequest": {
        "type": "object",
        "required": [
          "title",
          "durationMinutes"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GuestBooking": {
        "type": "object",
        "required": [
          "id",
          "title",
          "startsAt",
          "endsAt",
          "timeZone",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "timeZone": {
            "type": "string",
            "enum": [
              "Europe/Moscow"
            ]
          },
          "status": {
